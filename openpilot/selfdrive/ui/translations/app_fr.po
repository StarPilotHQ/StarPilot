msgid "Car PIN"
msgstr "PIN de la voiture"

#: openpilot/starpilot/galaxy/web/js/starport.js
msgid "Car passkey"
msgstr "Code d’appairage de la voiture"

#: openpilot/starpilot/galaxy/web/js/navigation.js
msgid "Change saved place category"
msgstr "Changer la catégorie du lieu enregistré"


#: openpilot/starpilot/ui/controller_feature.py
msgid "Join the StarPilot Discord and open a tuning request: https://firestar.link/discord"
msgstr "Tham gia Discord StarPilot và mở yêu cầu tinh chỉnh: https://firestar.link/discord"

#: openpilot/starpilot/galaxy/web/js/spotify.js
msgid "Keep Spotify enabled in step 4. A disconnected Bluetooth speaker can wait while you pair; music will be silent until it connects."
msgstr "Giữ Spotify bật ở bước 4. Loa Bluetooth bị ngắt có thể chờ trong khi ghép đôi; nhạc im lặng đến khi kết nối."

#: openpilot/starpilot/galaxy/web/js/flm-training-results.js
msgid "Learning paused; steering context changed"
msgstr "Học tạm dừng; ngữ cảnh lái đã đổi"

#: openpilot/starpilot/galaxy/web/js/flm-training-results.js
msgid "Learning state reported; trial application unknown"
msgstr "Đã báo cáo trạng thái học; không rõ áp dụng thử nghiệm"

#: openpilot/starpilot/ui/torque_feature.py
msgid "Legacy saved value; adopt to edit"
msgstr "Giá trị cũ đã lưu; tiếp nhận để sửa"

#: openpilot/starpilot/ui/slc_offset_feature.py
msgid "Legacy value; adopt to edit"
msgstr "Giá trị cũ; tiếp nhận để sửa"

#: openpilot/starpilot/ui/long_profile_feature.py
msgid "Limits acceleration by speed. Comfort is gentler; Sport and Sport+ allow stronger acceleration."
msgstr "Giới hạn gia tốc theo tốc độ. Thoải mái nhẹ hơn; Thể thao và Thể thao+ cho phép tăng tốc mạnh hơn."

#: openpilot/starpilot/ui/long_profile_feature.py
msgid "Limits acceleration by speed. Comfort is gentler; Sport and Sport+ allow stronger acceleration. Selected Profile follows the global choice."
msgstr "Giới hạn gia tốc theo tốc độ. Thoải mái nhẹ hơn; Thể thao và Thể thao+ cho phép tăng tốc mạnh hơn. Cấu hình đã chọn theo lựa chọn chung."

#: openpilot/starpilot/ui/long_profile_feature.py
msgid "Limits acceleration by speed. Comfort is gentler; Sport and Sport+ allow stronger acceleration. Selected Profile follows the global choice. An explicit choice overrides it; StarPilot Default keeps vehicle behavior."
msgstr "Giới hạn gia tốc theo tốc độ. Thoải mái nhẹ hơn; Thể thao và Thể thao+ cho phép tăng tốc mạnh hơn. Cấu hình đã chọn theo lựa chọn chung. Lựa chọn rõ ràng ghi đè nó; StarPilot mặc định giữ hành vi xe."

#: openpilot/starpilot/galaxy/web/data/catalog.json
msgid "Live cabin previews, Side Camera, Sentry motion, and V-ASM settings"
msgstr "Xem trước khoang xe trực tiếp, Camera bên, chuyển động Giám sát bảo vệ và cài đặt V-ASM"

#: openpilot/starpilot/galaxy/web/data/catalog.json
msgid "Live control plots and StarPilot Auto Learn results"
msgstr "Đồ thị điều khiển trực tiếp và kết quả Tự học StarPilot"

#: openpilot/starpilot/galaxy/web/js/hotspot.js
msgid "Local access without Internet; no Internet sharing."
msgstr "Truy cập cục bộ không cần Internet; không chia sẻ Internet."

#: openpilot/starpilot/galaxy/web/data/catalog.json
msgid "Logs, diagnostics, drive state, and help"
msgstr "Nhật ký, chẩn đoán, trạng thái lái và trợ giúp"

#: openpilot/starpilot/galaxy/web/js/offline-road-maps.js
msgid "Map. Tap or press Enter to center a new offline area; drag or use arrow keys to pan."
msgstr "Bản đồ. Chạm hoặc nhấn Enter để đặt tâm khu vực ngoại tuyến mới; kéo hoặc dùng phím mũi tên để di chuyển."

#: openpilot/starpilot/ui/lane_change_feature.py
msgid "Minimum detected adjacent lane width for an automatic lane change; narrower or uncertain lanes require a driver nudge"
msgstr "Chiều rộng làn liền kề phát hiện được tối thiểu để tự động chuyển làn; làn hẹp hơn hoặc không chắc chắn cần người lái nhích vô-lăng"

#: openpilot/starpilot/ui/sounds_owner.py
msgid "Minimum starting level; still ramps to full volume"
msgstr "Mức ban đầu tối thiểu; vẫn tăng lên âm lượng tối đa"

#: openpilot/starpilot/galaxy/web/js/vasm.js
msgid "Mirrored camera window canvas, editing"
msgstr "Khung cửa sổ camera lật gương, đang sửa"

#: openpilot/starpilot/galaxy/web/data/catalog.json
msgid "Models, downloads, and Jetlink connections"
msgstr "Mô hình, tải xuống và kết nối Jetlink"

#: openpilot/starpilot/galaxy/setting_descriptions.py
msgid "Moves the planned stopping point. Positive values stop farther forward; negative values stop earlier."
msgstr "Di chuyển điểm dừng dự kiến. Giá trị dương dừng xa hơn phía trước; giá trị âm dừng sớm hơn."

#: openpilot/starpilot/galaxy/web/js/spotify.js
msgid "Music plays through your car or speaker; alerts keep playing from the comma’s own speaker. Keep the music at a level where you can still hear the comma."
msgstr "Nhạc phát qua xe hoặc loa; cảnh báo tiếp tục phát từ loa riêng comma. Giữ nhạc ở mức bạn vẫn nghe được comma."

#: openpilot/starpilot/galaxy/web/data/catalog.json
msgid "Navigation & Maps"
msgstr "Dẫn đường và bản đồ"

#: openpilot/starpilot/galaxy/web/js/galaxy.js
msgid "New password (at least 8 characters)"
msgstr "Mật khẩu mới (ít nhất 8 ký tự)"

#: openpilot/starpilot/ui/ford_pinion_feature.py
msgid "Off by default. Uses steering-pinion curvature instead of RCM yaw in control and Panda safety. Applies next vehicle startup; Safe Mode must be off."
msgstr "Mặc định tắt. Dùng độ cong trục bánh răng lái thay vận tốc quay RCM trong điều khiển và an toàn Panda. Áp dụng lần khởi động xe tiếp theo; phải tắt Chế độ an toàn."

#: openpilot/starpilot/ui/feature_settings_owner.py
msgid "Offer or adopt mapped limits this many seconds early at the current speed; applies to increases and decreases"
msgstr "Đề nghị hoặc áp dụng giới hạn bản đồ sớm số giây này ở tốc độ hiện tại; áp dụng cho cả tăng và giảm"

#: openpilot/starpilot/ui/feature_settings_owner.py
msgid "On adjusts cruise speed to accepted limits; Off keeps speed control unchanged"
msgstr "Bật điều chỉnh tốc độ hành trình theo giới hạn được chấp nhận; Tắt giữ điều khiển tốc độ nguyên trạng"

#: openpilot/starpilot/ui/feature_settings_owner.py
msgid "On adopts new limits immediately; Off asks for confirmation within 10 seconds"
msgstr "Bật áp dụng giới hạn mới ngay; Tắt yêu cầu xác nhận trong vòng 10 giây"

#: openpilot/starpilot/galaxy/setting_descriptions.py
msgid "On displays speed and distance in kilometers; Off uses miles. Saved speed-limit offsets keep their physical values."
msgstr "Bật hiển thị tốc độ và khoảng cách bằng kilômét; Tắt dùng dặm. Độ lệch giới hạn tốc độ đã lưu giữ giá trị vật lý."

#: openpilot/starpilot/galaxy/localization_settings.py
msgid "On uses kilometers; Off uses miles. Saved speed-limit offsets keep their physical values."
msgstr "Bật dùng kilômét; Tắt dùng dặm. Độ lệch giới hạn tốc độ đã lưu giữ giá trị vật lý."


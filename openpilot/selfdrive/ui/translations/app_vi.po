msgstr "Kiểm tra hoạt động hệ thống cục bộ"

#: openpilot/starpilot/ui/sounds_owner.py
msgid "Installed sound packs and alert levels; Auto follows ambient sound."
msgstr "Gói âm thanh đã cài và mức cảnh báo; Tự động theo âm thanh môi trường."

#: openpilot/starpilot/ui/feature_settings_owner.py

msgstr "학습 상태가 보고되었으며 시험 적용은 알 수 없습니다"

#: openpilot/starpilot/ui/torque_feature.py
msgid "Legacy saved value; adopt to edit"
msgstr "기존 저장값입니다. 편집하려면 적용하세요"


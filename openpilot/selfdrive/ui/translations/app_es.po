#: openpilot/starpilot/ui/sounds_owner.py
msgid "Loud Blindspot Alert"
msgstr "Alerta fuerte de punto ciego"

#: openpilot/starpilot/ui/sounds_owner.py
msgid "Uses the soft-warning sound when a lane change is blocked by a detected blind-spot vehicle."
msgstr "Usa el sonido de advertencia suave cuando un vehículo detectado en el punto ciego bloquea un cambio de carril."

#: openpilot/starpilot/ui/sounds_owner.py
msgid "Blindspot Alert While Lateral Is Off"
msgstr "Alerta de punto ciego con control lateral desactivado"

#: openpilot/starpilot/ui/sounds_owner.py
msgid "Warns when signaling toward a detected blind-spot vehicle with steering assistance off or paused. Independent of Loud Blindspot Alert. Hazards do not trigger it."
msgstr "Advierte al señalizar hacia un vehículo detectado en el punto ciego con la asistencia de dirección desactivada o en pausa. Es independiente de la Alerta fuerte de punto ciego. Los intermitentes de emergencia no la activan."

msgid "Improves stopping behavior at traffic lights and enables automatic stopping at detected stop signs. Press the accelerator to continue."
msgstr "Mejora la detención en los semáforos y permite detenerse automáticamente ante las señales de stop detectadas. Pisa el acelerador para continuar."

msgid "Enhanced Stops"
msgstr "Paradas mejoradas"


#: openpilot/starpilot/ui/sounds_owner.py
msgid "Engine Sound"
msgstr "Sonido del motor"

#: openpilot/starpilot/ui/sounds_owner.py
msgid "Plays a simulated engine on the car speakers that follows the accelerator pedal."
msgstr "Reproduce un motor simulado en los altavoces del coche que sigue el pedal del acelerador."

#: openpilot/starpilot/ui/sounds_owner.py
msgid "Engine Type"
msgstr "Tipo de motor"

#: openpilot/starpilot/ui/sounds_owner.py
msgid "Chooses which engine is simulated."
msgstr "Elige qué motor se simula."

#: openpilot/starpilot/ui/sounds_owner.py
msgid "Engine Sound Volume"
msgstr "Volumen del sonido del motor"

#: openpilot/starpilot/ui/sounds_owner.py
msgid "Sets how loud the engine is before the car's own volume control."
msgstr "Ajusta el volumen del motor antes del control de volumen del propio coche."

#: openpilot/starpilot/engine_sound/profiles.py
msgid "Race Car"
msgstr "Coche de carreras"

#: openpilot/starpilot/engine_sound/profiles.py
msgid "Diesel Truck"
msgstr "Camión diésel"

#: openpilot/starpilot/engine_sound/profiles.py
msgid "Space Ship"
msgstr "Nave espacial"

#: openpilot/starpilot/galaxy/setting_descriptions.py
msgid "Plays a simulated engine on the car speakers that follows the accelerator pedal, including revving in Park or Neutral. Uses the audio output chosen under Spotify and Phone Audio, and goes quiet while an alert sounds."
msgstr "Reproduce un motor simulado en los altavoces del coche que sigue el pedal del acelerador, incluso al acelerar en Estacionamiento o Punto muerto. Usa la salida de audio elegida en Spotify y audio del teléfono, y se silencia mientras suena una alerta."

#: openpilot/starpilot/ui/sounds_owner.py
msgid "Preview Engine"
msgstr "Probar motor"

#: openpilot/starpilot/ui/sounds_owner.py
msgid "Revs the selected engine once on the car speakers, or on the comma when no car is connected."
msgstr "Acelera una vez el motor elegido en los altavoces del coche, o en el comma si no hay coche conectado."

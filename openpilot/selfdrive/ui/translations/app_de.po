msgstr "Wählt den simulierten Motor."

#: openpilot/starpilot/ui/sounds_owner.py
msgid "Engine Sound Volume"
msgstr "Lautstärke des Motorsounds"

#: openpilot/starpilot/ui/sounds_owner.py
msgid "Sets how loud the engine is before the car's own volume control."
msgstr "Legt die Lautstärke des Motors vor der Lautstärkeregelung des Fahrzeugs fest."

